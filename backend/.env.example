# ---- Server ----
PORT=4000
HOST=0.0.0.0
# Comma-separated list of allowed browser origins. "*" allows any (fine for local Wi-Fi demos).
CORS_ORIGINS=*
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ---- Database (Aiven PostgreSQL) ----
# Copy the "Service URI" from the Aiven console. Keep ?sslmode=require out; SSL is configured below.
DATABASE_URL=postgres://avnadmin:password@your-service.aivencloud.com:12345/defaultdb
# Path to Aiven's CA certificate (download "CA certificate" from the Aiven service overview).
# Leave empty for a local Postgres without SSL.
DB_CA_CERT_PATH=./ca.pem
DB_POOL_MAX=10

# ---- Admin seed ----
ADMIN_EMAIL=admin@local
ADMIN_PASSWORD=change-me-admin
ADMIN_NAME=Admin

# ---- Market data ----
# upstox | mock | licensed
PRICE_PROVIDER=upstox
# Analytics Token from Upstox Developer Apps -> Analytics tab (read-only, valid 1 year). Never expose to the frontend.
UPSTOX_ANALYTICS_TOKEN=
UPSTOX_API_BASE=https://api.upstox.com
UPSTOX_INSTRUMENTS_URL=https://assets.upstox.com/market-quote/instruments/exchange/MCX.json.gz
# Switch to the next contract this many days before expiry (also editable in admin settings).
ROLLOVER_DAYS_BEFORE_EXPIRY=3
# Run the history backfill automatically on startup (1 = yes)
BACKFILL_ON_START=1

# ---- Features ----
EMAIL_VERIFICATION=0
AI_COACH_ENABLED=0
AI_COACH_API_KEY=
AI_COACH_MODEL=claude-sonnet-5-5
AI_COACH_API_URL=https://api.anthropic.com/v1/messages
